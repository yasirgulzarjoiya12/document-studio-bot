# Keep secrets out of local build context by default is ideal, but this
# deployment relies on a committed .env for Back4App free containers.
# Prefer setting BOT_TOKEN in the platform Environment Variables when possible.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
data/*.sqlite3
data/*.sqlite3-*
downloads/*
!downloads/.gitkeep
logs/*
!logs/.gitkeep
job-data/*
!job-data/.gitkeep
*.zip
.DS_Store
.git
*.md~
PROJECT_SOURCE_BUNDLE.txt
